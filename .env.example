# =============================================================================
# GROW ANALYTICS PLATFORM - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and update the values for your environment
# Never commit .env files to version control

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV=development
PORT=8000
CLIENT_PORT=3000
APP_NAME="Grow Analytics Platform"
APP_VERSION=1.0.0
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL Database
DATABASE_URL="postgresql://username:password@localhost:5432/grow_db?schema=public"
DB_HOST=localhost
DB_PORT=5432
DB_NAME=grow_db
DB_USER=username
DB_PASSWORD=password
DB_SSL=false

# Database Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# JWT Secrets (Generate strong random strings in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-change-this-in-production
SESSION_MAX_AGE=86400000

# Password Hashing
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email Templates
FROM_EMAIL=noreply@grow-platform.com
FROM_NAME="Grow Analytics Platform"
SUPPORT_EMAIL=support@grow-platform.com

# =============================================================================
# FILE STORAGE
# =============================================================================
# Local Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,csv,xlsx

# AWS S3 (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=grow-platform-uploads

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# Analytics & Monitoring
GOOGLE_ANALYTICS_ID=
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=

# Social Authentication (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=combined
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Debug Mode
DEBUG=grow:*
VERBOSE_LOGGING=false

# Hot Reload
HOT_RELOAD=true
WATCH_FILES=true

# API Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=/api/docs

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================
# Security Headers
HELMET_ENABLED=true
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=false

# SSL/TLS
SSL_ENABLED=false
SSL_CERT_PATH=
SSL_KEY_PATH=

# Clustering
CLUSTER_ENABLED=false
CLUSTER_WORKERS=0

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================
# Test Database
TEST_DATABASE_URL="postgresql://username:password@localhost:5432/grow_test_db?schema=public"
TEST_REDIS_URL=redis://localhost:6379/1

# Test Settings
TEST_TIMEOUT=30000
TEST_COVERAGE_THRESHOLD=80

# =============================================================================
# DOCKER & KUBERNETES
# =============================================================================
# Container Settings
CONTAINER_PORT=8000
CONTAINER_MEMORY_LIMIT=512m
CONTAINER_CPU_LIMIT=0.5

# Kubernetes
K8S_NAMESPACE=grow-platform
K8S_SERVICE_ACCOUNT=grow-sa

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_ANALYTICS_DASHBOARD=true
FEATURE_REAL_TIME_UPDATES=true
FEATURE_EXPORT_DATA=true
FEATURE_NOTIFICATIONS=true
FEATURE_MULTI_TENANT=false
FEATURE_API_RATE_LIMITING=true

# =============================================================================
# THIRD-PARTY INTEGRATIONS
# =============================================================================
# Stripe (Payment Processing)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SendGrid (Email Service)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Twilio (SMS Service)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
